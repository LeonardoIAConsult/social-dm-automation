# ─────────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Meta / Instagram  (ver docs/SETUP_META.md para obtener cada valor)
# ─────────────────────────────────────────────────────────────

# Token que TU inventas. Debe coincidir con el que pones en el panel
# de Meta al configurar el webhook (campo "Verify Token").
META_WEBHOOK_VERIFY_TOKEN=pon-aqui-una-cadena-secreta-larga

# App Secret de tu app en developers.facebook.com (App Settings > Basic).
# Se usa para validar la firma X-Hub-Signature-256 de cada webhook.
META_APP_SECRET=

# Access token de larga duracion de la cuenta profesional de Instagram
# (o de la Pagina vinculada). Permiso requerido: instagram_business_manage_messages.
IG_ACCESS_TOKEN=

# ID de tu cuenta profesional de Instagram (Instagram-scoped o Page-scoped segun setup).
IG_BUSINESS_ACCOUNT_ID=

# Version del Graph API a usar.
GRAPH_API_VERSION=v21.0

# ─────────────────────────────────────────────────────────────
# Comportamiento del follow-gate
# ─────────────────────────────────────────────────────────────
# Si true, se exige que la persona siga la cuenta antes de entregar el valor.
FOLLOW_GATE_ENABLED=true

# Recurso por defecto (ej. link de agenda/Calendar) para DMs SIN palabra clave.
# OFF por defecto: un DM normal (un "hola", una pregunta) NO recibe auto-respuesta.
# Ponlo en true SOLO si quieres que todo DM sin keyword reciba el link por defecto.
DM_DEFAULT_ENABLED=false

# Google Sheet (publicada como CSV) con el mapa palabra -> link. Ver docs/RESOURCES_SHEET.md
RESOURCES_SHEET_CSV_URL=

# ─────────────────────────────────────────────────────────────
# Bandeja de conversaciones (/inbox) — UI read-only protegida con Basic Auth.
# La usa la revision de Meta para VER el mensaje entrante dentro de la app.
# Si ambas quedan vacias, /inbox responde 503 (deshabilitada).
# ─────────────────────────────────────────────────────────────
INBOX_USER=
INBOX_PASS=

# ─────────────────────────────────────────────────────────────
# Persistencia del estado de conversaciones
#   memory (default): en RAM, se pierde al reiniciar (bien para dev/DRY_RUN).
#   file: JSON local que sobrevive reinicios (evita re-enviar DMs ya entregados
#         y que /inbox se vacie). Requiere disco PERSISTENTE en el host.
#         OJO: el disco de Render Free es EFIMERO -> usa un disco montado o memory.
#   postgres: estado en Postgres externo (Neon/Supabase). Sobrevive reinicios
#         AUNQUE el disco sea efimero (caso Render Free) -> blinda /inbox para la
#         revision de Meta. Requiere DATABASE_URL (abajo).
# ─────────────────────────────────────────────────────────────
STORE_BACKEND=memory
STORE_FILE_PATH=./data/conversations.json
# Cadena de conexion Postgres (solo si STORE_BACKEND=postgres). Ej Neon:
# postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# Solo si tu Postgres usa cert autofirmado: 'true' desactiva la verificacion TLS.
# Default false = se verifica el cert (Neon/Supabase funcionan asi). No lo actives
# salvo que sepas por que (relajarlo abre la puerta a MITM en la conexion a la DB).
DATABASE_SSL_NO_VERIFY=false

# ─────────────────────────────────────────────────────────────
# Rate limit anti-ban: tope de envios por hora y por cuenta.
# Backstop para no pasar el limite de Meta (~200 msg/h). 0 = deshabilitado.
# Al alcanzarlo el envio se OMITE (no se encola).
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=180

# ─────────────────────────────────────────────────────────────
# Cola de envios (gap #2) — OPT-IN. Apagado = envio sincrono como siempre.
# Encendido: el webhook encola y responde rapido; la cola aplica el rate-limit
# (requeue si topa) y reintenta fallos transitorios (429/5xx/red) con backoff.
# En memoria (jobs se pierden si el proceso reinicia).
# ─────────────────────────────────────────────────────────────
SEND_QUEUE_ENABLED=false
SEND_QUEUE_MAX_ATTEMPTS=4

# ─────────────────────────────────────────────────────────────
# Pruebas locales (DRY_RUN) — no llama al Graph API real
# ─────────────────────────────────────────────────────────────
DRY_RUN=false
# En dry-run, respuestas simuladas del Graph API:
SIM_IS_FOLLOWER=true
SIM_CAPTION=Comenta "GUIA" y te la mando
SIM_MEDIA_TIMESTAMP=
SIM_DRIVE_LINK=https://drive.google.com/file/d/DEMO/view

# ─────────────────────────────────────────────────────────────
# Google Drive (entrega de PDFs por fecha del post) — ver directives/drive_delivery.md
# ─────────────────────────────────────────────────────────────
GDRIVE_ENABLED=false
GDRIVE_ROOT_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ─────────────────────────────────────────────────────────────
# Helper de token (execution/meta_token_setup.mjs) — opcional
# ─────────────────────────────────────────────────────────────
IG_APP_ID=
IG_SHORT_TOKEN=
